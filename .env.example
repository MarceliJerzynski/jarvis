# =========================================================================
# Environment Variables for your project container
# Copy this file to '.env' and customize it.
# Docker will automatically load these variables when the container starts.
# =========================================================================

# Example: Google Cloud project
# GOOGLE_CLOUD_PROJECT_ID=project 
# GOOGLE_CLOUD_PROJECT=project
# Example: Database connection
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=mysecretpassword

# Example: Custom Java/Maven options
# MAVEN_OPTS="-Xmx2048m -XX:MaxMetaspaceSize=512m"
# JAVA_TOOL_OPTIONS="-Dfile.encoding=UTF-8"

# Any other custom environment variables:
# MY_PROJECT_VARIABLE=value
